    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://leadflow:8000/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.Name, email: $json.Email, company: $json.Company, phone: $json.Phone, message: $json.Message, source: 'web_form', received_at: $json.submittedAt }) }}",
        "options": {"response": {"response": {"neverError": true}}, "timeout": 60000}
      },
      "id": "3f1c2a10-0002-4c5e-9a10-000000000002",
      "name": "Classify lead (LeadFlow API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2},
