# --- LLM -------------------------------------------------------------------
# fake (default, offline, deterministic) | anthropic | openai
# Real providers are opt-in: an API key alone never switches the provider.
LLM_PROVIDER=fake
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5

# FakeProvider fault injection (share of malformed responses, 0..1)
FAKE_FAILURE_RATE=0
FAKE_SEED=7

# --- Storage / CRM ---------------------------------------------------------
DB_PATH=out/leadflow.db
# sqlite | csv | sheets
CRM_SINK=sqlite
CSV_EXPORT_PATH=out/crm_export.csv
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Leads

# --- Notifications ---------------------------------------------------------
# console | slack (defaults to slack when SLACK_WEBHOOK_URL is set)
NOTIFIER=
SLACK_WEBHOOK_URL=

# --- Business rules --------------------------------------------------------
HOT_FIT_THRESHOLD=70
DEFAULT_PHONE_COUNTRY=57
